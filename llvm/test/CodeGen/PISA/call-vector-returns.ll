; ------------------------------------------------------------
; i1 return – lowerReturn case BitSize==1 (PISACallLowering.cpp)
; Three extension variants: anyext (default), sext, zext.
; ------------------------------------------------------------

; Callee declaration for i1 return and argument tests
declare i1 @callee_i1()
declare void @callee_takes_i1(i1)

; anyext: sel.16b with immediate 1 (true) or 0 (false)
define i1 @test_ret_i1(i32 %a, i32 %b) {
; CHECK-LABEL: .16b @test_ret_i1(
; CHECK-SAME: .reg .32b [[R32_W0:%[-a-zA-Z$._0-9]+]]
; CHECK-SAME: .reg .32b [[R32_W1:%[-a-zA-Z$._0-9]+]]
; CHECK: 	.pred [[P_P0:%[-a-zA-Z$._0-9]+]];
; CHECK-NEXT: 	.reg .16b [[R16_H0:%[-a-zA-Z$._0-9]+]];
; CHECK: 	scmp.lt.32b 	[[P_P0]], [[R32_W0]], [[R32_W1]];
; CHECK-NEXT: 	sel.16b 	[[R16_H0]], 1, 0, [[P_P0]];
; CHECK-NEXT: 	return [[R16_H0]];
  %c = icmp slt i32 %a, %b
  ret i1 %c
}

; sext: sel.16b with immediate -1 (all-ones) for true — lowerReturn Sext path
define signext i1 @test_ret_i1_sext(i32 %a) {
; CHECK-LABEL: .16b @test_ret_i1_sext(
; CHECK-SAME: .reg .32b [[R32_W0:%[-a-zA-Z$._0-9]+]]
; CHECK: 	.pred [[P_P0:%[-a-zA-Z$._0-9]+]];
; CHECK-NEXT: 	.reg .16b [[R16_H0:%[-a-zA-Z$._0-9]+]];
; CHECK: 	scmp.lt.32b 	[[P_P0]], [[R32_W0]], 0;
; CHECK-NEXT: 	sel.16b 	[[R16_H0]], -1, 0, [[P_P0]];
; CHECK-NEXT: 	return [[R16_H0]];
  %c = icmp slt i32 %a, 0
  ret i1 %c
}

; zext: sel.16b with immediate 1 — lowerReturn Zext path (same as anyext for i1)
define zeroext i1 @test_ret_i1_zext(i32 %a) {
; CHECK-LABEL: .16b @test_ret_i1_zext(
; CHECK-SAME: .reg .32b [[R32_W0:%[-a-zA-Z$._0-9]+]]
; CHECK: 	.pred [[P_P0:%[-a-zA-Z$._0-9]+]];
; CHECK-NEXT: 	.reg .16b [[R16_H0:%[-a-zA-Z$._0-9]+]];
; CHECK: 	scmp.lt.32b 	[[P_P0]], [[R32_W0]], 0;
; CHECK-NEXT: 	sel.16b 	[[R16_H0]], 1, 0, [[P_P0]];
; CHECK-NEXT: 	return [[R16_H0]];
  %c = icmp slt i32 %a, 0
  ret i1 %c
}

; Call returning i1 – lowerCall return-type handling for i1 (BitSize==1)
define void @test_call_ret_i1(ptr %out) {
; CHECK-LABEL: void @test_call_ret_i1(
; CHECK-SAME: .reg .64b [[R64_D0:%[-a-zA-Z$._0-9]+]]
; CHECK: 	.reg .16b [[R16_H0:%[-a-zA-Z$._0-9]+]];
; CHECK-NEXT: 	.reg .32b [[R32_W0:%[-a-zA-Z$._0-9]+]], [[R32_W1:%[-a-zA-Z$._0-9]+]];
; CHECK: 	call [[R16_H0]], @callee_i1 ();
; CHECK-NEXT: 	zext.32b.16b 	[[R32_W0]], [[R16_H0]];
; CHECK-NEXT: 	and.32b 	[[R32_W1]], [[R32_W0]], 1;
; CHECK-NEXT: 	st.generic.32b	 [[[R64_D0]]], [[R32_W1]];
; CHECK-NEXT: 	return;
  %r = call i1 @callee_i1()
  %ext = zext i1 %r to i32
  store i32 %ext, ptr %out
  ret void
}

; Call with i1 argument – lowerCall argument-passing for i1 (PISACallLowering.cpp)
define void @test_call_i1_arg(i1 %cond) {
; CHECK-LABEL: void @test_call_i1_arg(
; CHECK-SAME: .reg .16b [[R16_H0:%[-a-zA-Z$._0-9]+]]
; CHECK: 	.reg .16b [[R16_H1:%[-a-zA-Z$._0-9]+]];
; CHECK: 	and.16b 	[[R16_H1]], [[R16_H0]], 1;
; CHECK-NEXT: 	call void, @callee_takes_i1 ([[R16_H1]]);
; CHECK-NEXT: 	return;
  call void @callee_takes_i1(i1 %cond)
  ret void
}
