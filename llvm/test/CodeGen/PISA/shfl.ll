define i32 @shfl_sum_reduction(i32 %in, i32 %passthru) {
  %val16 = call i32 @llvm.pisa.shfl(i8 2, i32 %in, i32 16, i32 4294967295, i32 %passthru, i1 false)
  %sum16 = add i32 %val16, %in
  %val8 = call i32 @llvm.pisa.shfl(i8 2, i32 %sum16, i32 8, i32 4294967295, i32 %passthru, i1 false)
  %sum8 = add i32 %val8, %sum16
  %val4 = call i32 @llvm.pisa.shfl(i8 2, i32 %sum8, i32 4, i32 4294967295, i32 %passthru, i1 false)
  %sum4 = add i32 %val4, %sum8
  %val2 = call i32 @llvm.pisa.shfl(i8 2, i32 %sum4, i32 2, i32 4294967295, i32 %passthru, i1 false)
  %sum2 = add i32 %val2, %sum4
  %val1 = call i32 @llvm.pisa.shfl(i8 2, i32 %sum2, i32 1, i32 4294967295, i32 %passthru, i1 false)
  %sum1 = add i32 %val1, %sum2
  ret i32 %sum1
}

