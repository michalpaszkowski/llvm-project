; Function without any per-function target attributes.
; getSubtargetImpl falls back to getTargetCPU() and getTargetFeatureString().
define i32 @test_default_subtarget_attrs(i32 %a, i32 %b) {
; O0-LABEL: .32b @test_default_subtarget_attrs(
; O0-SAME: .reg .32b [[R32_W0:%[-a-zA-Z$._0-9]+]]
; O0-SAME: .reg .32b [[R32_W1:%[-a-zA-Z$._0-9]+]]
; O0: 	.reg .32b [[R32_W2:%[-a-zA-Z$._0-9]+]];
; O0: 	iadd.32b 	[[R32_W2]], [[R32_W0]], [[R32_W1]];
; O0-NEXT: 	return [[R32_W2]];
;
; CHECK-LABEL: .32b @test_default_subtarget_attrs(
; CHECK-SAME: .reg .32b [[R32_W0:%[-a-zA-Z$._0-9]+]]
; CHECK-SAME: .reg .32b [[R32_W1:%[-a-zA-Z$._0-9]+]]
; CHECK: 	.reg .32b [[R32_W2:%[-a-zA-Z$._0-9]+]];
; CHECK: 	iadd.32b 	[[R32_W2]], [[R32_W0]], [[R32_W1]];
; CHECK-NEXT: 	return [[R32_W2]];
  %r = add i32 %a, %b
  ret i32 %r
}

