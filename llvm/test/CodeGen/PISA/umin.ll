; Test that umin(UINT_MAX, x) folds to x when the identity constant is on the LHS.
; Covers matchMinMaxIdentityFold lines 2928-2931 (LHS-constant identity branch).
; UINT_MAX for i32 is -1 (all-ones bit pattern).
define i32 @test_umin32_identity_lhs(i32 %a) {
; CHECK-LABEL: .32b @test_umin32_identity_lhs(
; CHECK-SAME: .reg .32b [[R32_W0:%[-a-zA-Z$._0-9]+]]
; CHECK-NOT: umin
; CHECK: 	return [[R32_W0]];
  %result = call i32 @llvm.umin.i32(i32 -1, i32 %a)
  ret i32 %result
}

