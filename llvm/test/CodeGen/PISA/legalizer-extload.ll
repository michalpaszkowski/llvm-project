; RUN: llc < %s -march=pisa -verify-machineinstrs | FileCheck %s

; Tests for legalizeGExtload in PISALegalizerInfo.cpp (commit 526ab16).
;
; G_SEXTLOAD and G_ZEXTLOAD are custom-legalized: each is lowered to a narrow
; G_LOAD followed by a G_{S,Z}EXT.  The function checks line 1738:
;   if (isa<GSExtLoad>(MI))  ->  sext path (TRUE branch)
;   else                     ->  zext path (FALSE branch)
; Both branches must be covered.

define i32 @test_sextload_i8(ptr addrspace(3) %p) {
; CHECK-LABEL: .32b @test_sextload_i8(
; CHECK-SAME: .reg .32b [[R32_W0:%[-a-zA-Z$._0-9]+]]
; CHECK: .reg .32b [[R32_W1:%[-a-zA-Z$._0-9]+]];
; CHECK: .reg .8b [[R8_B0:%[-a-zA-Z$._0-9]+]];
; CHECK: ld.shared.8b
; CHECK: sext.32b.8b
; CHECK: return [[R32_W1]];
  %val = load i8, ptr addrspace(3) %p
  %ext = sext i8 %val to i32
  ret i32 %ext
}

define i32 @test_zextload_i8(ptr addrspace(3) %p) {
; CHECK-LABEL: .32b @test_zextload_i8(
; CHECK-SAME: .reg .32b [[R32_W0:%[-a-zA-Z$._0-9]+]]
; CHECK: .reg .32b [[R32_W1:%[-a-zA-Z$._0-9]+]];
; CHECK: .reg .8b [[R8_B0:%[-a-zA-Z$._0-9]+]];
; CHECK: ld.shared.8b
; CHECK: zext.32b.8b
; CHECK: return [[R32_W1]];
  %val = load i8, ptr addrspace(3) %p
  %ext = zext i8 %val to i32
  ret i32 %ext
}

