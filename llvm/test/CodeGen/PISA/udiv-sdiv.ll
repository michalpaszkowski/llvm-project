; CHECK: 	shr.64b 	%d1, [[R64_D0]], 32;
; CHECK-NEXT: 	and.64b 	%d2, [[R64_D0]], 4294967295;
; CHECK-NEXT: 	smul.64b 	%d3, %d2, 3435973836;
; CHECK-NEXT: 	smul.64b 	%d4, %d2, 3435973837;
