define i16 @test_udiv16(i16 %a, i16 %b) {
; CHECK-LABEL: .16b @test_udiv16(
; CHECK-SAME: .reg .16b [[R16_H0:%[-a-zA-Z$._0-9]+]]
; CHECK-SAME: .reg .16b [[R16_H1:%[-a-zA-Z$._0-9]+]]
; CHECK: 	.reg .16b [[R16_H2:%[-a-zA-Z$._0-9]+]], [[R16_H3:%[-a-zA-Z$._0-9]+]];
; CHECK: 	udiv.quo.16b 	[[R16_H2]], [[R16_H0]], [[R16_H1]];
; CHECK-NEXT: 	udiv.rem.16b 	[[R16_H3]], [[R16_H2]], 10;
; CHECK-NEXT: 	return [[R16_H3]];
  %1 = udiv i16 %a, %b
  %2 = urem i16 %1, 10
  ret i16 %2;
}

