; CHECK-NEXT: 	shr.64b 	%d9, %d3, 32;
; CHECK-NEXT: 	shr.64b 	%d10, %d8, 32;
; CHECK-NEXT: 	iadd.64b 	%d11, %d9, %d10;
; CHECK-NEXT: 	smad.64b 	%d12, %d1, 3435973836, %d11;
; CHECK-NEXT: 	shr.64b 	%d13, %d12, 3;
; CHECK-NEXT: 	return %d13;
  %1 = udiv i64 %a, 10
  ret i64 %1;
}

