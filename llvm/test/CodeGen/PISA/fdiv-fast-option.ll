; NOTE: Assertions have been autogenerated by utils/update_pisa_test_checks.py UTC_ARGS: --version 6
; RUN: llc < %s -march=pisa | FileCheck %s
; RUN: llc < %s -march=pisa -O0 -verify-machineinstrs | FileCheck --check-prefix=O0 %s

; FDIV-LABEL: @test_fdiv32fast
define float @test_fdiv32fast(float %a, float %b) {
; CHECK-LABEL: .32b @test_fdiv32fast(
; CHECK-SAME: .reg .32b [[R32_W0:%[-a-zA-Z$._0-9]+]]
; CHECK-SAME: .reg .32b [[R32_W1:%[-a-zA-Z$._0-9]+]]
; CHECK: 	.reg .32b [[R32_W2:%[-a-zA-Z$._0-9]+]];
; CHECK: 	fdiv.fast.f 	[[R32_W2]], [[R32_W0]], [[R32_W1]];
; CHECK-NEXT: 	return [[R32_W2]];
;
; O0-LABEL: .32b @test_fdiv32fast(
; O0-SAME: .reg .32b [[R32_W0:%[-a-zA-Z$._0-9]+]]
; O0-SAME: .reg .32b [[R32_W1:%[-a-zA-Z$._0-9]+]]
; O0: 	.reg .32b [[R32_W2:%[-a-zA-Z$._0-9]+]];
; O0: 	fdiv.fast.f 	[[R32_W2]], [[R32_W0]], [[R32_W1]];
; O0-NEXT: 	return [[R32_W2]];
  %result = fdiv arcp float %a, %b
  ret float %result
}

