; Verify that half FP immediates are correctly lowered to MC operands.
define void @test_fpimm_half(half %x) {
; CHECK-LABEL: void @test_fpimm_half(
; CHECK-SAME: .reg .16b [[R16_H0:%[-a-zA-Z$._0-9]+]]
; CHECK: 	.reg .16b [[R16_H1:%[-a-zA-Z$._0-9]+]], [[R16_H2:%[-a-zA-Z$._0-9]+]];
; CHECK-NEXT: 	.reg .64b [[R64_D0:%[-a-zA-Z$._0-9]+]];
; CHECK: 	mov.64b 	[[R64_D0]], 0;
; CHECK-NEXT: 	fmul.hf 	[[R16_H1]], [[R16_H0]], 0x3C00;
; CHECK-NEXT: 	fneg.hf 	[[R16_H2]], [[R16_H1]];
; CHECK-NEXT: 	st.global.16b	 [[[R64_D0]]], [[R16_H2]];
; CHECK-NEXT: 	return;
  %canon = fsub nsz half 0xH0000, %x
  store half %canon, ptr addrspace(1) null, align 2
  ret void
}

