; Nontemporal load from global address space: MONonTemporal flag causes
; L1uc.L2uc.L3uc cache hint to be applied instead of decoding target flags.
define i32 @load_nontemporal_global(ptr addrspace(1) %ptr) {
; CHECK-LABEL: .32b @load_nontemporal_global(
; CHECK-SAME: .reg .64b [[R64_D0:%[-a-zA-Z$._0-9]+]]
; CHECK: 	.reg .32b [[R32_W0:%[-a-zA-Z$._0-9]+]];
; CHECK: 	ld.global.L1uc.L2uc.L3uc.32b	 [[R32_W0]], [[[R64_D0]]];
; CHECK-NEXT: 	return [[R32_W0]];
  %val = load i32, ptr addrspace(1) %ptr, align 4, !nontemporal !17
  ret i32 %val
}

; Nontemporal store to global address space: nontemporal store maps to
; L1uc.L2uc.L3uc cache hint (value 2).
define void @store_nontemporal_global(ptr addrspace(1) %ptr, i32 %val) {
; CHECK-LABEL: void @store_nontemporal_global(
; CHECK-SAME: .reg .64b [[R64_D0:%[-a-zA-Z$._0-9]+]]
; CHECK-SAME: .reg .32b [[R32_W0:%[-a-zA-Z$._0-9]+]]
; CHECK: 	st.global.L1uc.L2uc.L3uc.32b	 [[[R64_D0]]], [[R32_W0]];
; CHECK-NEXT: 	return;
  store i32 %val, ptr addrspace(1) %ptr, align 4, !nontemporal !17
  ret void
}

; Nontemporal load from private address space: MONonTemporal flag applies
; L1uc.L2uc.L3uc cache hint regardless of address space.
define i32 @load_nontemporal_private(ptr addrspace(4) %ptr) {
; CHECK-LABEL: .32b @load_nontemporal_private(
; CHECK-SAME: .reg .32b [[R32_W0:%[-a-zA-Z$._0-9]+]]
; CHECK: 	.reg .32b [[R32_W1:%[-a-zA-Z$._0-9]+]];
; CHECK: 	ld.private.L1uc.L2uc.L3uc.32b	 [[R32_W1]], [[[R32_W0]]];
; CHECK-NEXT: 	return [[R32_W1]];
  %val = load i32, ptr addrspace(4) %ptr, align 4, !nontemporal !17
  ret i32 %val
}

; Nontemporal load combined with mmra: nontemporal takes precedence over
; mmra metadata because MONonTemporal is checked first.
define i32 @load_nontemporal_and_mmra(ptr addrspace(1) %ptr) {
; CHECK-LABEL: .32b @load_nontemporal_and_mmra(
; CHECK-SAME: .reg .64b [[R64_D0:%[-a-zA-Z$._0-9]+]]
; CHECK: 	.reg .32b [[R32_W0:%[-a-zA-Z$._0-9]+]];
; CHECK: 	ld.global.L1uc.L2uc.L3uc.32b	 [[R32_W0]], [[[R64_D0]]];
; CHECK-NEXT: 	return [[R32_W0]];
  %val = load i32, ptr addrspace(1) %ptr, align 4, !nontemporal !17, !mmra !9
  ret i32 %val
}

