; RUN: llc < %s -march=pisa -verify-machineinstrs | FileCheck %s
; RUN: llc < %s -march=pisa -O0 -verify-machineinstrs

; Extract low or high half of a v4i8 vector - exercises the sub8_xy/sub8_zw
; selection paths in the instruction selector and subreg-access optimizer.
define <2 x i8> @test_extract_low_half(<4 x i8> %a) {
; CHECK-LABEL: .v2.8b @test_extract_low_half(
; CHECK-SAME: .reg .v4.8b [[VR4_8_V4B0:%[-a-zA-Z$._0-9]+]]
; CHECK: 	return [[VR4_8_V4B0]].xy;
  %r = shufflevector <4 x i8> %a, <4 x i8> undef, <2 x i32> <i32 0, i32 1>
  ret <2 x i8> %r
}

define <2 x i8> @test_extract_high_half(<4 x i8> %a) {
; CHECK-LABEL: .v2.8b @test_extract_high_half(
; CHECK-SAME: .reg .v4.8b [[VR4_8_V4B0:%[-a-zA-Z$._0-9]+]]
; CHECK: 	return [[VR4_8_V4B0]].zw;
  %r = shufflevector <4 x i8> %a, <4 x i8> undef, <2 x i32> <i32 2, i32 3>
  ret <2 x i8> %r
}

; Combining two scalar bytes into a v2i8: each element is written to a different
; sub-register from a different source - the optimizer leaves these as-is.
define <2 x i8> @test_insert_two_elements(i8 %x, i8 %y) {
; CHECK-LABEL: .v2.8b @test_insert_two_elements(
; CHECK-SAME: .reg .8b [[R8_B0:%[-a-zA-Z$._0-9]+]]
; CHECK-SAME: .reg .8b [[R8_B1:%[-a-zA-Z$._0-9]+]]
; CHECK: 	.reg .v2.8b [[VR2_8_V2B0:%[-a-zA-Z$._0-9]+]];
; CHECK: 	mov.8b 	[[VR2_8_V2B0]].x, [[R8_B0]];
; CHECK-NEXT: 	mov.8b 	[[VR2_8_V2B0]].y, [[R8_B1]];
; CHECK-NEXT: 	return [[VR2_8_V2B0]];
  %v0 = insertelement <2 x i8> poison, i8 %x, i32 0
  %v1 = insertelement <2 x i8> %v0, i8 %y, i32 1
  ret <2 x i8> %v1
}
