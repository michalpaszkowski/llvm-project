; Valid rounding mode 0 (TowardZero), HasSaturation=true branch.
define float @test_fadd_rtz(float %a, float %b) {
; O0-LABEL: .32b @test_fadd_rtz(
; O0-SAME: .reg .32b [[R32_W0:%[-a-zA-Z$._0-9]+]]
; O0-SAME: .reg .32b [[R32_W1:%[-a-zA-Z$._0-9]+]]
; O0: 	.reg .32b [[R32_W2:%[-a-zA-Z$._0-9]+]];
; O0: 	fadd.rz.f 	[[R32_W2]], [[R32_W0]], [[R32_W1]];
; O0-NEXT: 	return [[R32_W2]];
;
; CHECK-LABEL: .32b @test_fadd_rtz(
; CHECK-SAME: .reg .32b [[R32_W0:%[-a-zA-Z$._0-9]+]]
; CHECK-SAME: .reg .32b [[R32_W1:%[-a-zA-Z$._0-9]+]]
; CHECK: 	.reg .32b [[R32_W2:%[-a-zA-Z$._0-9]+]];
; CHECK: 	fadd.rz.f 	[[R32_W2]], [[R32_W0]], [[R32_W1]];
; CHECK-NEXT: 	return [[R32_W2]];
  %r = call float @llvm.pisa.fadd.f32(float %a, float %b, i8 0, i1 0)
  ret float %r
}

