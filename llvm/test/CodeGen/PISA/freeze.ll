; Tests for isLegalType() with vector types - covers the NumElts==16 and
; NumElts==64 sub-conditions in the EltSize==32 vector branch (commit 0294911).
; These vectors pass isLegalType() so G_IMPLICIT_DEF is legal for them.

declare void @use_v16_32b(<16 x i32>)
declare void @use_v64_32b(<64 x i32>)

; <16 x i32> freeze: exercises isLegalType with NumElts==16, EltSize==32 (legal).
define void @test_def_v16_32b(<16 x i32> %a) {
; CHECK-LABEL: void @test_def_v16_32b(
; CHECK: call void, @use_v16_32b
; CHECK-NEXT: return;
  %1 = freeze <16 x i32> %a
  call void @use_v16_32b(<16 x i32> %1)
  ret void
}

; <64 x i32> freeze: exercises isLegalType with NumElts==64, EltSize==32 (legal).
define void @test_def_v64_32b(<64 x i32> %a) {
; CHECK-LABEL: void @test_def_v64_32b(
; CHECK: call void, @use_v64_32b
; CHECK-NEXT: return;
  %1 = freeze <64 x i32> %a
  call void @use_v64_32b(<64 x i32> %1)
  ret void
}

