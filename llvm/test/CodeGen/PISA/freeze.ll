; This test checks that freeze is substitued with variable for defined.
; For undef/poison we currently emit a copy.
; RUN: llc < %s -march=pisa -verify-machineinstrs | FileCheck --check-prefixes=CHECK,PISA %s
; RUN: llc < %s -march=pisa -O0 -verify-machineinstrs


declare void @use_8b(i8)
declare void @use_16b(i16, half)
declare void @use_32b(i32, float)
declare void @use_64b(i64, double)


define void @test_def_8b(i8 %a) {
; CHECK-LABEL: void @test_def_8b(
; CHECK-SAME: .reg .8b [[R8_B0:%[-a-zA-Z$._0-9]+]]
; CHECK: 	call void, @use_8b ([[R8_B0]]);
; CHECK-NEXT: 	return;
  %1 = freeze i8 %a
  call void @use_8b(i8 %1)
  ret void
}

