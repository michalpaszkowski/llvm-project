    ; LEGAL: [[INTTOPTR3:%[0-9]+]]:_(p4) = G_INTTOPTR [[EVEC3]](i32)
    ; LEGAL: [[INTTOPTR4:%[0-9]+]]:_(p4) = G_INTTOPTR [[EVEC4]](i32)
    ; LEGAL: [[PTRTOINT:%[0-9]+]]:_(i32) = G_PTRTOINT [[INTTOPTR]](p4)
    ; LEGAL: [[PTRTOINT1:%[0-9]+]]:_(i32) = G_PTRTOINT [[INTTOPTR1]](p4)
    ; LEGAL: [[PTRTOINT2:%[0-9]+]]:_(i32) = G_PTRTOINT [[INTTOPTR2]](p4)
    ; LEGAL: [[PTRTOINT3:%[0-9]+]]:_(i32) = G_PTRTOINT [[INTTOPTR3]](p4)
    ; LEGAL: [[BUILD_VECTOR:%[0-9]+]]:_(<4 x i32>) = G_BUILD_VECTOR [[PTRTOINT]](i32), [[PTRTOINT1]](i32), [[PTRTOINT2]](i32), [[PTRTOINT3]](i32)
    ; LEGAL: G_STORE [[BUILD_VECTOR]](<4 x i32>), [[C]](p1) :: (store (<4 x i32>) into `ptr addrspace(1) null`, align 8, addrspace 1)
    ; LEGAL: [[C6:%[0-9]+]]:_(p1) = G_CONSTANT i64 16
    ; LEGAL: [[PTRTOINT4:%[0-9]+]]:_(i32) = G_PTRTOINT [[INTTOPTR4]](p4)
    ; LEGAL: G_STORE [[PTRTOINT4]](i32), [[C6]](p1) :: (store (i32) into `ptr addrspace(1) null` + 16, align 8, addrspace 1)
    ; LEGAL: ret

   ; ASM-LABEL: void @test_load_store_ptr_vector_global_5elem(
   ; ASM: 	.reg .64b [[R64_R0:%[-a-zA-Z$._0-9]+]], [[R64_R8:%[-a-zA-Z$._0-9]+]];
   ; ASM: 	.reg .v3.64b [[VR3_64_R1:%[-a-zA-Z$._0-9]+]];
   ; ASM: 	.reg .v2.32b [[VR2_32_R2:%[-a-zA-Z$._0-9]+]], [[VR2_32_R3:%[-a-zA-Z$._0-9]+]], [[VR2_32_R4:%[-a-zA-Z$._0-9]+]];
   ; ASM: 	.reg .v6.32b [[VR6_32_R5:%[-a-zA-Z$._0-9]+]];
   ; ASM: 	.reg .32b [[R32_R6:%[-a-zA-Z$._0-9]+]];
