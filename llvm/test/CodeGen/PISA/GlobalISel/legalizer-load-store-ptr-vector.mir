    ; LEGAL: [[C2:%[0-9]+]]:_(i32) = G_CONSTANT i32 1
    ; LEGAL: [[EVEC1:%[0-9]+]]:_(i32) = G_EXTRACT_VECTOR_ELT [[EXTRACT_SUBVECTOR]](<5 x i32>), [[C2]](i32)
