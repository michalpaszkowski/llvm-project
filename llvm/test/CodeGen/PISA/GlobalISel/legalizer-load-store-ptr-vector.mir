   ; ASM: 	mov.64b 	[[VR2_32_R3]].xy, [[VR3_64_R1]].y;
   ; ASM: 	mov.64b 	[[VR2_32_R4]].xy, [[VR3_64_R1]].z;
   ; ASM: 	insert.0.v2.32b 	[[VR6_32_R5]], [[VR2_32_R2]];
   ; ASM: 	insert.2.v2.32b 	[[VR6_32_R5]], [[VR2_32_R3]];
   ; ASM: 	insert.4.v2.32b 	[[VR6_32_R5]], [[VR2_32_R4]];
   ; ASM: 	extract.4.32b 	[[R32_R6]], [[VR6_32_R5]];
