   ; ASM: 	mov.64b 	[[VR4_32_R7]].zw, [[VR6_32_R5]].zw;
   ; ASM: 	st.global.v4.32b	 [[[R64_R0]]], [[VR4_32_R7]];
   ; ASM: 	mov.64b 	[[R64_R8]], 16;
   ; ASM: 	st.global.32b	 [[[R64_R8]]], [[R32_R6]];
   ; ASM: 	return;

    %1:_(p1) = G_CONSTANT i64 0
    %0:_(<5 x p4>) = G_LOAD %1(p1) :: (load (<5 x p4>) from `ptr addrspace(1) null`, align 8, addrspace 1)
    G_STORE %0(<5 x p4>), %1(p1) :: (store (<5 x p4>) into `ptr addrspace(1) null`, align 8, addrspace 1)
    ret
