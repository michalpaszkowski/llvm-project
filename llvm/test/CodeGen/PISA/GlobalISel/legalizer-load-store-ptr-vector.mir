# RUN: llc -march=pisa -run-pass=legalizer -verify-machineinstrs %s -o - | FileCheck -check-prefix=LEGAL %s
# RUN: llc -march=pisa -start-before=legalizer -verify-machineinstrs %s -o - | FileCheck -check-prefix=ASM %s
# Check that loads/stores of odd-sized vectors of pointers are legalized correctly.

--- |
  define void @test_load_store_ptr_vector(ptr addrspace(4) %in, ptr addrspace(4) %out) {
    %val = load <5 x ptr addrspace(4)>, ptr addrspace(4) %in
    store <5 x ptr addrspace(4)> %val, ptr addrspace(4) %out
    ret void
  }

  define void @test_load_store_ptr_vector_global_5elem() {
    %LGV7 = load <5 x ptr addrspace(4)>, ptr addrspace(1) null, align 8
    store <5 x ptr addrspace(4)> %LGV7, ptr addrspace(1) null, align 8
    ret void
  }

  define void @test_load_store_ptr_vector_global_6elem() {
    %LGV7 = load <6 x ptr addrspace(4)>, ptr addrspace(1) null, align 8
    store <6 x ptr addrspace(4)> %LGV7, ptr addrspace(1) null, align 8
    ret void
  }

  define void @test_load_store_ptr_vector_global_7elem() {
    %LGV7 = load <7 x ptr addrspace(4)>, ptr addrspace(1) null, align 8
    store <7 x ptr addrspace(4)> %LGV7, ptr addrspace(1) null, align 8
    ret void
  }
...
---
name:              test_load_store_ptr_vector
tracksRegLiveness: true
body:             |
  bb.1:
    ; LEGAL-LABEL: {{^}}name: test_load_store_ptr_vector
    ; LEGAL: [[IN:%.+]]:reg32b(p4) = functionParameter_i32 0
    ; LEGAL: [[OUT:%.+]]:reg32b(p4) = functionParameter_i32 1
    ; LEGAL: [[LOAD_VEC:%.+]]:_(<4 x i32>) = G_LOAD [[IN]](p4)
    ; LEGAL: [[ELEM0:%.+]]:_(i32), [[ELEM1:%.+]]:_(i32), [[ELEM2:%.+]]:_(i32), [[ELEM3:%.+]]:_(i32) = G_UNMERGE_VALUES [[LOAD_VEC]](<4 x i32>)
    ; LEGAL: [[PTR0:%.+]]:_(p4) = G_INTTOPTR [[ELEM0]](i32)
    ; LEGAL: [[PTR1:%.+]]:_(p4) = G_INTTOPTR [[ELEM1]](i32)
    ; LEGAL: [[PTR2:%.+]]:_(p4) = G_INTTOPTR [[ELEM2]](i32)
    ; LEGAL: [[PTR3:%.+]]:_(p4) = G_INTTOPTR [[ELEM3]](i32)
    ; LEGAL: [[CONST16:%.+]]:_(i32) = G_CONSTANT i32 16
    ; LEGAL: [[PTR_ADD:%.+]]:_(p4) = nuw inbounds G_PTR_ADD [[IN]], [[CONST16]](i32)
    ; LEGAL: [[LOAD_SCALAR:%.+]]:_(i32) = G_LOAD [[PTR_ADD]](p4)
    ; LEGAL: [[PTR_SCALAR:%.+]]:_(p4) = G_INTTOPTR [[LOAD_SCALAR]](i32)
    ; LEGAL: [[INT0:%.+]]:_(i32) = G_PTRTOINT [[PTR0]](p4)
    ; LEGAL: [[INT1:%.+]]:_(i32) = G_PTRTOINT [[PTR1]](p4)
    ; LEGAL: [[INT2:%.+]]:_(i32) = G_PTRTOINT [[PTR2]](p4)
    ; LEGAL: [[INT3:%.+]]:_(i32) = G_PTRTOINT [[PTR3]](p4)
    ; LEGAL: [[VEC:%.+]]:_(<4 x i32>) = G_BUILD_VECTOR [[INT0]](i32), [[INT1]](i32), [[INT2]](i32), [[INT3]](i32)
    ; LEGAL: G_STORE [[VEC]](<4 x i32>), [[OUT]](p4)
    ; LEGAL: [[CONST16_2:%.+]]:_(i32) = G_CONSTANT i32 16
    ; LEGAL: [[PTR_ADD2:%.+]]:_(p4) = nuw inbounds G_PTR_ADD [[OUT]], [[CONST16_2]](i32)
    ; LEGAL: [[INT_SCALAR:%.+]]:_(i32) = G_PTRTOINT [[PTR_SCALAR]](p4)
    ; LEGAL: G_STORE [[INT_SCALAR]](i32), [[PTR_ADD2]](p4)
    ; LEGAL: ret

    ; ASM-LABEL: @test_load_store_ptr_vector
    ; ASM: (.reg .32b [[R0:%w[0-9]+]], .reg .32b [[R1:%w[0-9]+]])
    ; ASM: .reg .32b [[R3:%w[0-9]+]];
    ; ASM: .reg .v4.32b [[R2:%v4w[0-9]+]];
    ; ASM: ld.private.v4.32b [[R2]], [[[R0]]];
    ; ASM: ld.private.32b [[R3]], [[[R0]] + 16];
    ; ASM: st.private.v4.32b [[[R1]]], [[R2]];
    ; ASM: st.private.32b [[[R1]] + 16], [[R3]];
    ; ASM: return;

    %0:reg32b(p4) = functionParameter_i32 0
    %1:reg32b(p4) = functionParameter_i32 1
    %2:_(<5 x p4>) = G_LOAD %0:reg32b(p4) :: (load (<5 x p4>) from %ir.in, align 32)
    G_STORE %2:_(<5 x p4>), %1:reg32b(p4) :: (store (<5 x p4>) into %ir.out, align 32)
    ret

...
