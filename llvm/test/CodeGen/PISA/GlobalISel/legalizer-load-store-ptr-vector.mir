    ; LEGAL: [[C:%[0-9]+]]:_(p1) = G_CONSTANT i64 0
    ; LEGAL: [[LOAD:%[0-9]+]]:_(<3 x i64>) = G_LOAD [[C]](p1) :: (load (<3 x i64>) from `ptr addrspace(1) null`, align 8, addrspace 1)
    ; LEGAL: [[UV:%[0-9]+]]:_(i64), [[UV1:%[0-9]+]]:_(i64), [[UV2:%[0-9]+]]:_(i64) = G_UNMERGE_VALUES [[LOAD]](<3 x i64>)
    ; LEGAL: [[BITCAST:%[0-9]+]]:_(<2 x i32>) = G_BITCAST [[UV]](i64)
    ; LEGAL: [[BITCAST1:%[0-9]+]]:_(<2 x i32>) = G_BITCAST [[UV1]](i64)
    ; LEGAL: [[BITCAST2:%[0-9]+]]:_(<2 x i32>) = G_BITCAST [[UV2]](i64)
    ; LEGAL: [[DEF:%[0-9]+]]:_(<6 x i32>) = IMPLICIT_DEF
    ; LEGAL: [[INSERT_SUBVECTOR:%[0-9]+]]:_(<6 x i32>) = G_INSERT_SUBVECTOR [[DEF]], [[BITCAST]](<2 x i32>), 0
    ; LEGAL: [[INSERT_SUBVECTOR1:%[0-9]+]]:_(<6 x i32>) = G_INSERT_SUBVECTOR [[INSERT_SUBVECTOR]], [[BITCAST1]](<2 x i32>), 2
    ; LEGAL: [[INSERT_SUBVECTOR2:%[0-9]+]]:_(<6 x i32>) = G_INSERT_SUBVECTOR [[INSERT_SUBVECTOR1]], [[BITCAST2]](<2 x i32>), 4
    ; LEGAL: [[COPY:%[0-9]+]]:_(<6 x i32>) = COPY [[INSERT_SUBVECTOR2]](<6 x i32>)
    ; LEGAL: [[EXTRACT_SUBVECTOR:%[0-9]+]]:_(<5 x i32>) = G_EXTRACT_SUBVECTOR [[COPY]](<6 x i32>), 0
    ; LEGAL: [[C1:%[0-9]+]]:_(i32) = G_CONSTANT i32 0
