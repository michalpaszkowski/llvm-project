    ; LEGAL: [[EVEC4:%[0-9]+]]:_(i32) = G_EXTRACT_VECTOR_ELT [[EXTRACT_SUBVECTOR]](<5 x i32>), [[C5]](i32)
    ; LEGAL: [[INTTOPTR:%[0-9]+]]:_(p4) = G_INTTOPTR [[EVEC]](i32)
    ; LEGAL: [[INTTOPTR1:%[0-9]+]]:_(p4) = G_INTTOPTR [[EVEC1]](i32)
