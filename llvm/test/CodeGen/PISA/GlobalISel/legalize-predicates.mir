# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 5
# RUN: llc -march=pisa -run-pass=pisa-legalize-predicates -verify-machineinstrs %s -o - | FileCheck %s

# Promotion is gated on the predicate chain genuinely *escaping* the boolean
# domain -- either a vector extract (G_EXTRACT_VECTOR_ELT) or a non-bool
# (integer-typed) value already in the chain. A pure boolean reduction whose
# every consumer is an i1 sink (G_BRCOND / G_SELECT condition) is left
# untouched: the legalizer widens-and-fuses it optimally, whereas promoting it
# would only insert a sext + (!=0) round trip that some downstream consumers
# fold away but others do not -- where it survives it defeats bfn fusion. The
# unpromoted (input == output) functions below are intentional negative cases
# guarding that gate.

--- |
  ; ModuleID = '<stdin>'
  source_filename = "<stdin>"
  target datalayout = "e-p:64:64-p1:64:64-p2:64:64-p3:32:32-p4:32:32-i1:8:8-i8:8:8-i16:16:16-i32:32:32-i64:64:64-f32:32:32-f64:64:64-v16:16:16-v24:32:32-v32:32:32-v48:64:64-v64:64:64-v96:128:128-v128:128:128-v192:256:256-v256:256:256-G1-A4"
  target triple = "pisa"

  define i32 @scalar_fcmp_and3_to_br(<3 x float> %arg) {
    %cmp_i1 = fcmp fast oeq <3 x float> %arg, zeroinitializer
    %x = extractelement <3 x i1> %cmp_i1, i64 0
    %y = extractelement <3 x i1> %cmp_i1, i64 1
    %z = extractelement <3 x i1> %cmp_i1, i64 2
    %and_xy = and i1 %x, %y
    %and_xyz = and i1 %and_xy, %z
    br i1 %and_xyz, label %then, label %else

  then:                                             ; preds = %0
    ret i32 1

  else:                                             ; preds = %0
    ret i32 0
  }

  define i32 @vec_extract_and_chain(<3 x float> %arg) {
    %cmp_i1 = fcmp fast oeq <3 x float> %arg, zeroinitializer
    %cmp_x = extractelement <3 x i1> %cmp_i1, i64 0
    %cmp_y = extractelement <3 x i1> %cmp_i1, i64 1
    %cmp_z = extractelement <3 x i1> %cmp_i1, i64 2
    %and_xy = and i1 %cmp_x, %cmp_y
    %and_xyz = and i1 %and_xy, %cmp_z
    %neg = icmp eq i1 %and_xyz, false
    %result = select i1 %neg, i32 123, i32 456
    ret i32 %result
  }

  define i32 @sext_to_i8_then_and(<3 x float> %arg) {
    %cmp_i1 = fcmp fast oeq <3 x float> %arg, zeroinitializer
    %sx = sext <3 x i1> %cmp_i1 to <3 x i8>
    %x = extractelement <3 x i8> %sx, i64 0
    %y = extractelement <3 x i8> %sx, i64 1
    %z = extractelement <3 x i8> %sx, i64 2
    %and_xy = and i8 %x, %y
    %and_xyz = and i8 %and_xy, %z
    %nz = icmp ne i8 %and_xyz, 0
    %result = select i1 %nz, i32 1, i32 0
    ret i32 %result
  }

  define i32 @mixed_sinks(i32 %a, i32 %b, i32 %c) {
    %c1 = icmp slt i32 %a, %b
    %c2 = icmp slt i32 %b, %c
    %and = and i1 %c1, %c2
    br i1 %and, label %then, label %else

  then:                                             ; preds = %0
    %xor = xor i1 %and, %c1
    %sel = select i1 %xor, i32 10, i32 20
    ret i32 %sel

  else:                                             ; preds = %0
    ret i32 0
  }

  define i32 @or_chain_icmp(i32 %dst_width, i32 %dst_height, i32 %conv, i32 %conv2, i32 %conv3) {
    %cmp = icmp sle i32 %dst_width, %conv
    %cmp4 = icmp sle i32 %dst_height, %conv2
    %cmp5 = icmp sge i32 %dst_height, %conv3
    %or.1 = or i1 %cmp5, %cmp4
    %or.cond = or i1 %or.1, %cmp
    br i1 %or.cond, label %b1, label %b2

  b1:                                               ; preds = %0
    ret i32 0

  b2:                                               ; preds = %0
    ret i32 1
  }

  define i32 @no_bitwise_no_change(i32 %a, i32 %b) {
    %c = icmp slt i32 %a, %b
    %s = select i1 %c, i32 7, i32 9
    ret i32 %s
  }

  define i32 @const_true_in_and_chain(i32 %a, i32 %b) {
    %c1 = icmp slt i32 %a, 0
    %c2 = icmp slt i32 %b, 0
    %and1 = and i1 %c1, %c2
    %and2 = and i1 %and1, true
    br i1 %and2, label %then, label %else

  then:                                             ; preds = %0
    ret i32 1

  else:                                             ; preds = %0
    ret i32 0
  }

  define i32 @const_false_in_or_chain(i32 %a, i32 %b) {
    %c1 = icmp slt i32 %a, 0
    %c2 = icmp slt i32 %b, 0
    %or1 = or i1 %c1, %c2
    %or2 = or i1 %or1, false
    br i1 %or2, label %then, label %else

  then:                                             ; preds = %0
    ret i32 1

  else:                                             ; preds = %0
    ret i32 0
  }

  define i32 @icmp_eq_two_ands(i32 %a, i32 %b, i32 %c) {
    %c1 = icmp slt i32 %a, %b
    %c2 = icmp slt i32 %a, %c
    %c3 = icmp slt i32 %b, %c
    %and1 = and i1 %c1, %c2
    %and2 = and i1 %c2, %c3
    %check = icmp eq i1 %and1, %and2
    %r = select i1 %check, i32 1, i32 0
    ret i32 %r
  }

  define i32 @phi_i1_blocks_promotion(i32 %0, i32 %1, i8 %2) {
  entry:
    %3 = trunc i8 %2 to i1
    %c1 = icmp slt i32 %0, 0
    %c2 = icmp slt i32 %1, 0
    %and = and i1 %c1, %c2
    br i1 %3, label %then, label %merge

  then:                                             ; preds = %entry
    %t = and i1 %and, %c1
    br label %merge

  merge:                                            ; preds = %entry, %then
    %p = phi i1 [ %t, %then ], [ %c2, %entry ]
    br i1 %p, label %tt, label %ee

  tt:                                               ; preds = %merge
    ret i32 1

  ee:                                               ; preds = %merge
    ret i32 0
  }

  define void @vec_sink_blocks_promotion(<3 x float> %arg, ptr %p) {
    %c = fcmp oeq <3 x float> %arg, zeroinitializer
    %s = sext <3 x i1> %c to <3 x i8>
    store <3 x i8> %s, ptr %p, align 4
    ret void
  }

  define i64 @sext_to_i64_then_and(<3 x float> %arg) {
    %cmp_i1 = fcmp fast oeq <3 x float> %arg, zeroinitializer
    %sx = sext <3 x i1> %cmp_i1 to <3 x i64>
    %x = extractelement <3 x i64> %sx, i64 0
    %y = extractelement <3 x i64> %sx, i64 1
    %z = extractelement <3 x i64> %sx, i64 2
    %and_xy = and i64 %x, %y
    %and_xyz = and i64 %and_xy, %z
    ret i64 %and_xyz
  }

  define i32 @i32_chain_direct_alias(i32 %a, i32 %b) {
    %c1 = icmp slt i32 %a, 0
    %c2 = icmp slt i32 %b, 0
    %sx1 = sext i1 %c1 to i32
    %sx2 = sext i1 %c2 to i32
    %and = and i32 %sx1, %sx2
    %or = or i32 %and, %sx1
    ret i32 %or
  }

  define i32 @icmp_eq_nonbool_const(i32 %a, i32 %b, i32 %c) {
    %c1 = icmp slt i32 %a, 0
    %c2 = icmp slt i32 %b, 0
    %c3 = icmp slt i32 %c, 0
    %and1 = and i1 %c1, %c2
    %and2 = and i1 %and1, %c3
    %sx = sext i1 %and2 to i32
    %check = icmp eq i32 %sx, 5
    %r = select i1 %check, i32 1, i32 0
    ret i32 %r
  }

  define i8 @vec_two_chains_extract_cascade(<3 x float> %0, ptr %1) {
    %c = fcmp oeq <3 x float> %0, zeroinitializer
    %x = extractelement <3 x i1> %c, i64 0
    %y = extractelement <3 x i1> %c, i64 1
    %and = and i1 %x, %y
    %sx = sext <3 x i1> %c to <3 x i8>
    store <3 x i8> %sx, ptr %1, align 4
    %3 = zext i1 %and to i8
    ret i8 %3
  }

  define i32 @zext_trunc_chain(i32 %a, i32 %b, i32 %c) {
    %c1 = icmp slt i32 %a, 0
    %c2 = icmp slt i32 %b, 0
    %z1 = zext i1 %c1 to i8
    %z2 = zext i1 %c2 to i8
    %and1 = and i8 %z1, %z2
    %t = trunc i8 %and1 to i1
    %c3 = icmp slt i32 %c, 0
    %and2 = and i1 %t, %c3
    br i1 %and2, label %then, label %else

  then:                                             ; preds = %0
    ret i32 1

  else:                                             ; preds = %0
    ret i32 0
  }

  define i32 @icmp_const_on_lhs(i32 %a, i32 %b, i32 %c) {
    %c1 = icmp slt i32 %a, 0
    %c2 = icmp slt i32 %b, 0
    %c3 = icmp slt i32 %c, 0
    %and1 = and i1 %c1, %c2
    %and2 = and i1 %and1, %c3
    %sx = sext i1 %and2 to i32
    %check = icmp eq i32 0, %sx
    %r = select i1 %check, i32 1, i32 0
    ret i32 %r
  }

  define i32 @cascade_through_and_operand(i32 %0, i32 %1, i8 %2) {
  entry:
    %c1 = icmp slt i32 %0, 0
    %c2 = icmp slt i32 %1, 0
    %and1 = and i1 %c1, %c2
    %and2 = and i1 %and1, %c1
    br i1 %and2, label %then, label %merge

  then:                                             ; preds = %entry
    br label %merge

  merge:                                            ; preds = %entry, %then
    %p = phi i1 [ %and1, %then ], [ %c2, %entry ]
    br i1 %p, label %tt, label %ee

  tt:                                               ; preds = %merge
    ret i32 1

  ee:                                               ; preds = %merge
    ret i32 0
  }

  define i32 @zext_with_numeric_sink(i32 %a, i32 %b, i32 %c) {
    %c1 = icmp slt i32 %a, 0
    %c2 = icmp slt i32 %b, 0
    %z1 = zext i1 %c1 to i8
    %z2 = zext i1 %c2 to i8
    %and1 = and i8 %z1, %z2
    %t = trunc i8 %and1 to i1
    %c3 = icmp slt i32 %c, 0
    %and2 = and i1 %t, %c3
    %sum = add i8 %z1, %z2
    %ext = zext i8 %sum to i32
    br i1 %and2, label %then, label %else

  then:
    ret i32 %ext

  else:
    ret i32 0
  }

  define i32 @icmp_eq_two_promotable(i32 %a, i32 %b, i32 %c) {
    %c1 = icmp slt i32 %a, 0
    %c2 = icmp slt i32 %b, 0
    %c3 = icmp slt i32 %c, 0
    %and1 = and i1 %c1, %c2
    %and2 = and i1 %c2, %c3
    %eq = icmp eq i1 %and1, %and2
    br i1 %eq, label %then, label %else

  then:
    ret i32 1

  else:
    ret i32 0
  }

  define i32 @xor_chain(i32 %a, i32 %b, i32 %c) {
    %c1 = icmp slt i32 %a, 0
    %c2 = icmp slt i32 %b, 0
    %c3 = icmp slt i32 %c, 0
    %xor1 = xor i1 %c1, %c2
    %xor2 = xor i1 %xor1, %c3
    br i1 %xor2, label %then, label %else

  then:
    ret i32 1

  else:
    ret i32 0
  }

  ; A two-operand G_XOR reduction that escapes the boolean domain through an
  ; integer sink (zext + add). Promotion applies here, so this guards the
  ; Phase-3 rewrite of a non-constant G_XOR reduction node.
  define i32 @xor_reduction_numeric_sink(i32 %a, i32 %b, i32 %c) {
    %c1 = icmp slt i32 %a, 0
    %c2 = icmp slt i32 %b, 0
    %c3 = icmp slt i32 %c, 0
    %xor1 = xor i1 %c1, %c2
    %xor2 = xor i1 %xor1, %c3
    %ext = zext i1 %xor2 to i32
    %sum = add i32 %ext, 42
    ret i32 %sum
  }

  define i32 @mixed_and_or_xor(i32 %a, i32 %b, i32 %c) {
    %c1 = icmp slt i32 %a, 0
    %c2 = icmp slt i32 %b, 0
    %c3 = icmp slt i32 %c, 0
    %and = and i1 %c1, %c2
    %or = or i1 %and, %c3
    %xor = xor i1 %or, %c1
    br i1 %xor, label %then, label %else

  then:
    ret i32 1

  else:
    ret i32 0
  }

  define i32 @zext_i1_to_i32_with_numeric_sink(i32 %a, i32 %b, i32 %c) {
    %c1 = icmp slt i32 %a, 0
    %c2 = icmp slt i32 %b, 0
    %and = and i1 %c1, %c2
    %c3 = icmp slt i32 %c, 0
    %or = or i1 %and, %c3
    %ext = zext i1 %or to i32
    %sum = add i32 %ext, 42
    ret i32 %sum
  }

  define i32 @zext_and_chain_numeric_i32(i32 %a, i32 %b, i32 %c, i32 %d) {
    %c1 = icmp slt i32 %a, %b
    %c2 = icmp slt i32 %b, %c
    %c3 = icmp slt i32 %c, %d
    %z1 = zext i1 %c1 to i32
    %z2 = zext i1 %c2 to i32
    %z3 = zext i1 %c3 to i32
    %and1 = and i32 %z1, %z2
    %and2 = and i32 %and1, %z3
    ret i32 %and2
  }

  define void @zext_and_chain_store_i8(i32 %a, i32 %b, i32 %c, i32 %d, ptr %p) {
    %c1 = icmp slt i32 %a, %b
    %c2 = icmp slt i32 %b, %c
    %c3 = icmp slt i32 %c, %d
    %z1 = zext i1 %c1 to i8
    %z2 = zext i1 %c2 to i8
    %z3 = zext i1 %c3 to i8
    %and1 = and i8 %z1, %z2
    %and2 = and i8 %and1, %z3
    store i8 %and2, ptr %p, align 1
    ret void
  }

  define i64 @zext_or_chain_numeric_i64(i32 %a, i32 %b, i32 %c, i32 %d) {
    %c1 = icmp slt i32 %a, %b
    %c2 = icmp slt i32 %b, %c
    %c3 = icmp slt i32 %c, %d
    %z1 = zext i1 %c1 to i64
    %z2 = zext i1 %c2 to i64
    %z3 = zext i1 %c3 to i64
    %or1 = or i64 %z1, %z2
    %or2 = or i64 %or1, %z3
    ret i64 %or2
  }

  define i32 @mixed_sext_zext_bail(i32 %a, i32 %b, i32 %c, i32 %d) {
    %c1 = icmp slt i32 %a, %b
    %c2 = icmp slt i32 %b, %c
    %c3 = icmp slt i32 %c, %d
    %s1 = sext i1 %c1 to i32
    %z2 = zext i1 %c2 to i32
    %s3 = sext i1 %c3 to i32
    %and1 = and i32 %s1, %z2
    %and2 = and i32 %and1, %s3
    ret i32 %and2
  }


  define i32 @vec_icmp_eq_two_promotable(<3 x float> %a, <3 x float> %b) {
    %c1 = fcmp oeq <3 x float> %a, zeroinitializer
    %c2 = fcmp oeq <3 x float> %b, zeroinitializer
    %s1 = sext <3 x i1> %c1 to <3 x i32>
    %s2 = sext <3 x i1> %c2 to <3 x i32>
    %and = and <3 x i32> %s1, %s2
    %eq = icmp eq <3 x i32> %and, %s1
    %x = extractelement <3 x i1> %eq, i64 0
    %y = extractelement <3 x i1> %eq, i64 1
    %r = and i1 %x, %y
    %sel = select i1 %r, i32 1, i32 0
    ret i32 %sel
  }

  define i32 @vec_icmp_ne_zero_splat(<3 x float> %a, <3 x float> %b) {
    %c1 = fcmp oeq <3 x float> %a, zeroinitializer
    %c2 = fcmp oeq <3 x float> %b, zeroinitializer
    %s1 = sext <3 x i1> %c1 to <3 x i32>
    %s2 = sext <3 x i1> %c2 to <3 x i32>
    %and = and <3 x i32> %s1, %s2
    %ne = icmp ne <3 x i32> %and, zeroinitializer
    %x = extractelement <3 x i1> %ne, i64 0
    %y = extractelement <3 x i1> %ne, i64 1
    %r = and i1 %x, %y
    %sel = select i1 %r, i32 1, i32 0
    ret i32 %sel
  }


  define i32 @not_of_cmp_not_promoted(i32 %a, i32 %b, i32 %c) {
    %c1 = icmp slt i32 %a, %b
    %c2 = icmp slt i32 %b, %c
    %n = xor i1 %c1, true
    %and = and i1 %n, %c2
    br i1 %and, label %t, label %f
  t:
    ret i32 1
  f:
    ret i32 0
  }


    define i32 @cov_const_in_wide_bitwise(i32 %a, i32 %b) {
      %c1 = icmp slt i32 %a, 0
      %c2 = icmp slt i32 %b, 0
      %s1 = sext i1 %c1 to i32
      %s2 = sext i1 %c2 to i32
      %and = and i32 %s1, %s2
      %xor = xor i32 %and, -1
      %or = or i32 %xor, %s1
      ret i32 %or
    }

    define i32 @cov_anyext_chain(i32 %a, i32 %b, i32 %c) {
      %c1 = icmp slt i32 %a, 0
      %c2 = icmp slt i32 %b, 0
      %c3 = icmp slt i32 %c, 0
      %z1 = zext i1 %c1 to i32
      %z2 = zext i1 %c2 to i32
      %z3 = zext i1 %c3 to i32
      %and1 = and i32 %z1, %z2
      %and2 = and i32 %and1, %z3
      ret i32 %and2
    }

  define i32 @cov_const_zero_in_bitwise(i32 %a, i32 %b) {
    %c1 = icmp slt i32 %a, 0
    %c2 = icmp slt i32 %b, 0
    %s1 = sext i1 %c1 to i32
    %s2 = sext i1 %c2 to i32
    %and = and i32 %s1, %s2
    ret i32 %and
  }

    define void @cov_trunc_to_i16(i32 %a, i32 %b, ptr %p) {
      %c1 = icmp slt i32 %a, 0
      %c2 = icmp slt i32 %b, 0
      %s1 = sext i1 %c1 to i32
      %s2 = sext i1 %c2 to i32
      %and1 = and i32 %s1, %s2
      %and2 = and i32 %and1, %s1
      %t = trunc i32 %and2 to i16
      store i16 %t, ptr %p, align 2
      ret void
    }

    define i32 @cov_bitwise_nonpred_operand(i32 %a, i32 %b, i32 %x) {
      %c1 = icmp slt i32 %a, 0
      %c2 = icmp slt i32 %b, 0
      %s1 = sext i1 %c1 to i32
      %s2 = sext i1 %c2 to i32
      %and1 = and i32 %s1, %s2
      %and2 = and i32 %and1, %s1
      %np = and i32 %x, %s1
      %r = add i32 %and2, %np
      ret i32 %r
    }

    define i32 @cov_eq_nonpred_operand(i32 %a, i32 %b, i32 %c, i32 %x) {
      %c1 = icmp slt i32 %a, 0
      %c2 = icmp slt i32 %b, 0
      %c3 = icmp slt i32 %c, 0
      %and1 = and i1 %c1, %c2
      %and2 = and i1 %and1, %c3
      %nt = trunc i32 %x to i1
      %eq = icmp eq i1 %and2, %nt
      %sel = select i1 %eq, i32 1, i32 0
      ret i32 %sel
    }

    define i32 @cov_mixed_domain_second_operand(i32 %a, i32 %b, i32 %c, i32 %d) {
      %c1 = icmp slt i32 %a, 0
      %c2 = icmp slt i32 %b, 0
      %c3 = icmp slt i32 %c, 0
      %c4 = icmp slt i32 %d, 0
      %s1 = sext i1 %c1 to i32
      %s4 = sext i1 %c4 to i32
      %s2 = sext i1 %c2 to i32
      %z3 = zext i1 %c3 to i32
      %clean = and i32 %s1, %s4
      %mixed = and i32 %s2, %z3
      %outer = and i32 %clean, %mixed
      ret i32 %outer
    }
    define i32 @cov_xor_const_first(i32 %a, i32 %b) {
      %c1 = icmp slt i32 %a, 0
      %c2 = icmp slt i32 %b, 0
      %n = xor i1 %c1, true
      %and = and i1 %n, %c2
      br i1 %and, label %t, label %f

    t:                                                ; preds = %0
      ret i32 1

    f:                                                ; preds = %0
      ret i32 0
    }

  define i32 @cov_ne_two_promotable(i32 %a, i32 %b, i32 %c) {
    %c1 = icmp slt i32 %a, 0
    %c2 = icmp slt i32 %b, 0
    %c3 = icmp slt i32 %c, 0
    %and1 = and i1 %c1, %c2
    %and2 = and i1 %c2, %c3
    %ne = icmp ne i1 %and1, %and2
    br i1 %ne, label %then, label %else

  then:
    ret i32 1

  else:
    ret i32 0
  }

  ; A reduction that feeds BOTH an integer escape (store i32) AND a predicate
  ; sink (br). Although it has an escaping sink, promoting it would emit the
  ; round-trip restore at the branch and defeat bfn-with-flag fusion, so the
  ; mixed chain is left unpromoted (input == output).
  define i32 @mixed_escape_and_pred_sink(i32 %a, i32 %b, i32 %c, i32 %d, ptr addrspace(1) %p) {
    %c1 = icmp slt i32 %a, %b
    %c2 = icmp slt i32 %b, %c
    %c3 = icmp slt i32 %c, %d
    %a1 = and i1 %c1, %c2
    %a2 = and i1 %a1, %c3
    %z = zext i1 %a2 to i32
    store i32 %z, ptr addrspace(1) %p
    br i1 %a2, label %t, label %f

  t:
    ret i32 1

  f:
    ret i32 0
  }

  ; Two reduction chains compared by an icmp eq whose result escapes via a
  ; zext + i32 store (no predicate sink). The eq peephole sees both operands
  ; promotable, so it compares the promoted s32 forms directly.
  define i32 @icmp_eq_two_chains_store(i32 %a, i32 %b, i32 %c, ptr addrspace(1) %p) {
    %c1 = icmp slt i32 %a, 0
    %c2 = icmp slt i32 %b, 0
    %c3 = icmp slt i32 %c, 0
    %a1 = and i1 %c1, %c2
    %a2 = and i1 %c2, %c3
    %e = icmp eq i1 %a1, %a2
    %z = zext i1 %e to i32
    store i32 %z, ptr addrspace(1) %p
    ret i32 %z
  }

  ; As above but an icmp ne of two promoted chains; the kept-alive cmp has both
  ; operands redirected to their s32 forms at the restore boundary.
  define i32 @icmp_ne_two_chains_store(i32 %a, i32 %b, i32 %c, ptr addrspace(1) %p) {
    %c1 = icmp slt i32 %a, 0
    %c2 = icmp slt i32 %b, 0
    %c3 = icmp slt i32 %c, 0
    %a1 = and i1 %c1, %c2
    %a2 = and i1 %c2, %c3
    %e = icmp ne i1 %a1, %a2
    %z = zext i1 %e to i32
    store i32 %z, ptr addrspace(1) %p
    ret i32 %z
  }

  ; Vectorized cmp reduction (the extract makes promotion profitable) feeding an
  ; icmp eq with the boolean constant on the left-hand side.
  define i32 @icmp_eq_zero_lhs_vec(<3 x float> %arg) {
    %cmp = fcmp fast oeq <3 x float> %arg, zeroinitializer
    %x = extractelement <3 x i1> %cmp, i64 0
    %y = extractelement <3 x i1> %cmp, i64 1
    %z = extractelement <3 x i1> %cmp, i64 2
    %a1 = and i1 %x, %y
    %a2 = and i1 %a1, %z
    %e = icmp eq i1 false, %a2
    %r = select i1 %e, i32 123, i32 456
    ret i32 %r
  }

  ; Vectorized reduction sign-extended to i32 and compared against a wide
  ; constant that is neither zero nor all-ones.
  define i32 @icmp_eq_wide_const_vec(<3 x float> %arg) {
    %cmp = fcmp fast oeq <3 x float> %arg, zeroinitializer
    %x = extractelement <3 x i1> %cmp, i64 0
    %y = extractelement <3 x i1> %cmp, i64 1
    %z = extractelement <3 x i1> %cmp, i64 2
    %a1 = and i1 %x, %y
    %a2 = and i1 %a1, %z
    %s = sext i1 %a2 to i32
    %e = icmp eq i32 %s, 5
    %r = select i1 %e, i32 123, i32 456
    ret i32 %r
  }

  ; Vectorized reduction compared by icmp eq whose other operand is a
  ; non-promotable i1 (a truncated function argument).
  define i32 @icmp_eq_nonpromotable_lhs_vec(<3 x float> %arg, i32 %n) {
    %cmp = fcmp fast oeq <3 x float> %arg, zeroinitializer
    %x = extractelement <3 x i1> %cmp, i64 0
    %y = extractelement <3 x i1> %cmp, i64 1
    %z = extractelement <3 x i1> %cmp, i64 2
    %a1 = and i1 %x, %y
    %a2 = and i1 %a1, %z
    %np = trunc i32 %n to i1
    %e = icmp eq i1 %np, %a2
    %r = select i1 %e, i32 123, i32 456
    ret i32 %r
  }

  ; A cmp whose result is already a wide integer (not i1) is not a predicate
  ; seed, so the forward scan skips it.
  define i32 @icmp_nonbool_result_no_promote(i32 %a, i32 %b) {
    %c = icmp slt i32 %a, %b
    %z = zext i1 %c to i32
    ret i32 %z
  }

  ; A promoted value consumed by a kept-alive cmp with a non-eq/ne predicate:
  ; the operand-redirect fast path is skipped (the predicate is neither eq nor
  ; ne), so the operand is restored normally.
  define i32 @icmp_slt_promoted_kept_alive_vec(<3 x float> %arg) {
    %cmp = fcmp fast oeq <3 x float> %arg, zeroinitializer
    %x = extractelement <3 x i1> %cmp, i64 0
    %y = extractelement <3 x i1> %cmp, i64 1
    %z = extractelement <3 x i1> %cmp, i64 2
    %a1 = and i1 %x, %y
    %a2 = and i1 %a1, %z
    %s = sext i1 %a2 to i32
    %lt = icmp slt i32 %s, 7
    %r = select i1 %lt, i32 123, i32 456
    ret i32 %r
  }

...
