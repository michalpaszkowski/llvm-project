# RUN: llc -march=pisa -run-pass=legalizer -verify-machineinstrs %s -o -   | FileCheck -check-prefix=LEGAL %s
# RUN: llc -march=pisa -start-before=legalizer -verify-machineinstrs %s -o - | FileCheck -check-prefix=ASM  %s

--- |
  define i64 @test_merge_2_i32() {
    ret i64 0
  }
...
name:            test_merge_2_i32
tracksRegLiveness: true
body: |
  bb.0:
    ; LEGAL-LABEL: name: test_merge_2_i32
    ; LEGAL: [[C0:%[0-9]+]]:registers(i32) = G_CONSTANT
    ; LEGAL: [[C1:%[0-9]+]]:registers(i32) = G_CONSTANT
    ; LEGAL: {{[0-9]+}}:registers(i64) = G_MERGE_VALUES [[C0]](i32), [[C1]](i32)

    ; ASM:  mov.32b %v2w0.x, 0;
    ; ASM:  mov.32b %v2w0.y, 1;

    %0:registers(i32) = G_CONSTANT i32 0
    %1:registers(i32) = G_CONSTANT i32 1
    %2:registers(i64) = G_MERGE_VALUES %0:registers(i32), %1:registers(i32)
    %3:reg64b(i64) = COPY %2:registers(i64)
    retValue_i64_r %3:reg64b(i64)

...

