; NOTE: Assertions have been autogenerated by utils/update_pisa_test_checks.py UTC_ARGS: --version 6
; RUN: llc < %s -march=pisa -verify-machineinstrs | FileCheck %s
; RUN: llc < %s -march=pisa -O0 -verify-machineinstrs

; Test: Return a constant i8 value - exercises selectG_CONSTANT for i8.
; G_CONSTANT i8 is legal in PISA but has no tablegen GISel pattern,
; so selectImpl falls through to selectG_CONSTANT which emits mov_i8_i.
define i8 @test_i8_const_ret() {
; CHECK-LABEL: .8b @test_i8_const_ret(
; CHECK: 	.reg .8b [[R8_B0:%[-a-zA-Z$._0-9]+]];
; CHECK: 	mov.8b 	[[R8_B0]], 42;
; CHECK-NEXT: 	return [[R8_B0]];
  ret i8 42
}

; Test: Store a constant i8 - verifies G_CONSTANT i8 materialization
; via selectG_CONSTANT emits mov_i8_i before a store instruction.
define void @test_i8_const_store(ptr addrspace(4) %addr) {
; CHECK-LABEL: void @test_i8_const_store(
; CHECK-SAME: .reg .32b [[R32_W0:%[-a-zA-Z$._0-9]+]]
; CHECK: 	.reg .8b [[R8_B0:%[-a-zA-Z$._0-9]+]];
; CHECK: 	mov.8b 	[[R8_B0]], 7;
; CHECK-NEXT: 	st.private.8b	 [[[R32_W0]]], [[R8_B0]];
; CHECK-NEXT: 	return;
  store i8 7, ptr addrspace(4) %addr, align 1
  ret void
}
