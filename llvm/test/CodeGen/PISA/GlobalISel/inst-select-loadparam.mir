# RUN: llc -march=pisa -run-pass=instruction-select -verify-machineinstrs %s -o -   | FileCheck -check-prefix=ISEL %s
# RUN: llc -march=pisa -start-before=instruction-select -verify-machineinstrs %s -o - | FileCheck -check-prefix=ASM  %s
--- |
  %struct.byref = type { i32, i16, i64, i8 }

  define pisa_kernel void @kernel_byref_rr(ptr addrspace(1) %p, ptr addrspace(2) byref(%struct.byref) %s, i64 %index) {
    %aidx = getelementptr inbounds i8, ptr addrspace(2) %s, i64 %index
    %v = load i8, ptr addrspace(2) %aidx, align 1
    store i8 %v, ptr addrspace(1) %p, align 1
    ret void
  }

...
---
name:            kernel_byref_rr
legalized:       true
regBankSelected: true
tracksRegLiveness: true
body:             |
  bb.1 (%ir-block.0):
    ; ISEL-LABEL: {{^}}name:  kernel_byref_rr
    ; ASM-LABEL: @kernel_byref_rr
    %0:reg64b(p1) = loadParam_i64 0, 0
    %1:registers(p2) = G_PISA_PARAM_SLOT 1, 0
    ; ISEL: %{{[0-9]+}}:reg32b = trunc_32b_64b_r %{{[0-9]+}}
    ; ISEL: %{{[0-9]+}}:reg8b = loadParam_i8_ir 1, %{{[0-9]+}}
    ; ASM:  trunc.32b.64b %w{{[0-9]+}}, %d{{[0-9]+}}
    ; ASM:  ld.param.8b %b{{[0-9]+}}, [%arg1 + %w{{[0-9]+}}]
    %2:reg64b(i64) = loadParam_i64 2, 0
    %3:registers(p2) = G_PTR_ADD %1, %2(i64)
    %4:registers(p2) = COPY %3(p2)
    %5:registers(i8) = G_LOAD %4(p2) :: (invariant load (i8) from %ir.aidx, addrspace 2)
    G_STORE %5(i8), %0(p1) :: (store (i8) into %ir.p, addrspace 1)
    ret
