# NOTE: Assertions have been autogenerated by utils/update_pisa_test_checks.py UTC_ARGS: --indent-check-lines --version 5
# RUN: llc -march=pisa -run-pass=legalizer -verify-machineinstrs %s -o - | FileCheck -check-prefix=LEGAL %s
# RUN: llc -march=pisa -start-before=legalizer %disable_optional_optimizations -verify-machineinstrs %s -o - | FileCheck -check-prefixes=ASM,ASM_LESS_OPT %s

# Check that i1 operand of freeze inst is extended to i32.

--- |
  define pisa_kernel void @test(i1 %0, i1 %1, i1 %2, ptr addrspace(4) writeonly align 8 captures(none) %3) {
    ; ASM-LABEL: @test(
    ; ASM-SAME: .param[0] .align(4) [[PARAM_ARG0:%[-a-zA-Z$._0-9]+]]
    ; ASM-SAME: .param[0] .align(4) [[PARAM_ARG1:%[-a-zA-Z$._0-9]+]]
    ; ASM-SAME: .param[0] .align(4) [[PARAM_ARG2:%[-a-zA-Z$._0-9]+]]
    ; ASM-SAME: .param[0] {{.*}} [[PARAM_ARG3:%[-a-zA-Z$._0-9]+]]
    ; ASM: 	.reg .8b [[R8_B0:%[-a-zA-Z$._0-9]+]];
    ; ASM-NEXT: 	.reg .64b [[R64_D0:%[-a-zA-Z$._0-9]+]], [[R64_D1:%[-a-zA-Z$._0-9]+]];
    ; ASM-NEXT: 	.reg .32b [[R32_W0:%[-a-zA-Z$._0-9]+]], [[R32_W1:%[-a-zA-Z$._0-9]+]];
    ; ASM-NEXT: 	.pred [[P_P0:%[-a-zA-Z$._0-9]+]];
    ; ASM: 	ld.param.8b [[R8_B0]], [[[PARAM_ARG0]]];
    ; ASM-NEXT: 	mov.64b 	[[R64_D0]], 0;
    ; ASM-NEXT: 	zext.32b.8b 	[[R32_W0]], [[R8_B0]];
    ; ASM-NEXT: 	and.32b 	[[R32_W1]], [[R32_W0]], 1;
    ; ASM-NEXT: 	ucmp.ne.32b 	[[P_P0]], [[R32_W1]], 0;
    ; ASM-NEXT: 	sel.64b 	[[R64_D1]], 0x0000000000000000, 0x3FF0000000000000, [[P_P0]];
    ; ASM-NEXT: 	st.global.64b	 [[[R64_D0]]], [[R64_D1]];
    ; ASM-NEXT: 	return;
    br i1 %1, label %.lr.ph, label %.preheader

  .lr.ph:
    %brmerge = select i1 %2, i1 %0, i1 false
    br label %.backedge

  .preheader:
    %spec.select = select i1 %0, double 0.000000e+00, double 1.000000e+00
    store double %spec.select, ptr addrspace(1) null, align 8
    ret void

  .backedge:
    br i1 %brmerge, label %.backedge, label %5

  5:
    store double 0.000000e+00, ptr addrspace(4) %3, align 8
    br label %.backedge
  }

  define i32 @zext16(i32 %dst_width, i32 %dst_height, i32 %conv, i32 %conv2) {
  ;
  ; ASM_LESS_OPT-LABEL: .32b @zext16(
  ; ASM_LESS_OPT-SAME: .reg .32b [[R32_W0:%[-a-zA-Z$._0-9]+]]
  ; ASM_LESS_OPT-SAME: .reg .32b [[R32_W1:%[-a-zA-Z$._0-9]+]]
  ; ASM_LESS_OPT-SAME: .reg .32b [[R32_W2:%[-a-zA-Z$._0-9]+]]
  ; ASM_LESS_OPT-SAME: .reg .32b [[R32_W3:%[-a-zA-Z$._0-9]+]]
  ; ASM_LESS_OPT: 	.reg .32b %w<4~10>;
  ; ASM_LESS_OPT-NEXT: 	.pred [[P_P0:%[-a-zA-Z$._0-9]+]];
  ; ASM_LESS_OPT: 	scmp.le.32b 	%w4, [[R32_W1]], [[R32_W3]];
  ; ASM_LESS_OPT-NEXT: 	scmp.le.32b 	%w5, [[R32_W0]], [[R32_W2]];
  ; ASM_LESS_OPT-NEXT: 	or.32b 	%w6, %w5, %w4;
  ; ASM_LESS_OPT-NEXT: 	and.32b 	%w7, %w6, 1;
  ; ASM_LESS_OPT-NEXT: 	ucmp.ne.32b 	[[P_P0]], %w7, 0;
  ; ASM_LESS_OPT-NEXT: 	goto.cond [[P_P0]], [[LBB1_2:LBB[0-9_]+]];
  ; ASM_LESS_OPT: 	mov.32b 	%w8, 0;
  ; ASM_LESS_OPT-NEXT: 	return %w8;
  ; ASM_LESS_OPT-NEXT: [[LBB1_2]]:
  ; ASM_LESS_OPT-NEXT: 	mov.32b 	%w9, 1;
  ; ASM_LESS_OPT-NEXT: 	return %w9;
  b0:
    %cmp = icmp sle i32 %dst_width, %conv
    %cmp4 = icmp sle i32 %dst_height, %conv2
    %or.cond = select i1 %cmp, i1 true, i1 %cmp4
    br i1 %or.cond, label %b2, label %b1

  b1:
    ret i32 0

  b2:
    ret i32 1
  }

...

---
name:            test
tracksRegLiveness: true
body:             |
  bb.1:
    %0:reg8b(i8) = loadParam_i8 0, 0
    %1:reg8b(i1) = G_TRUNC %0(i8)
    %2:_(f64) = G_FCONSTANT double 0.000000e+00
    %3:_(f64) = G_FCONSTANT double 1.000000e+00
    %4:_(p1) = G_CONSTANT i64 0

    ; LEGAL: %[[#]]:_(i32) = G_FREEZE

    %5:_(i1) = G_FREEZE %1
    %6:_(f64) = G_SELECT %5(i1), %2, %3
    G_STORE %6(f64), %4(p1) :: (store (i64) into `ptr addrspace(1) null`, align 8, addrspace 1)
    ret
...

---
name:            zext16
tracksRegLiveness: true
body:             |
  bb.1.b0:
    %0:reg32b(i32) = functionParameter_i32 0
    %1:reg32b(i32) = functionParameter_i32 1
    %2:reg32b(i32) = functionParameter_i32 2
    %3:reg32b(i32) = functionParameter_i32 3
    %8:_(i32) = G_CONSTANT i32 0
    %10:_(i32) = G_CONSTANT i32 1
    %4:_(i1) = G_ICMP intpred(sle), %0:reg32b(i32), %2:reg32b
    %5:_(i1) = G_ICMP intpred(sle), %1:reg32b(i32), %3:reg32b
    ; LEGAL: %[[#]]:_(i32) = G_FREEZE
    %13:_(i1) = G_FREEZE %5:_
    %6:_(i1) = G_OR %4:_, %13:_
    G_BRCOND %6:_(i1), %bb.3
    G_BR %bb.2

  bb.2.b1:
    %9:reg32b(i32) = COPY %8:_(i32)
    retValue_i32_r %9:reg32b(i32)

  bb.3.b2:
    %11:reg32b(i32) = COPY %10:_(i32)
    retValue_i32_r %11:reg32b(i32)
...
