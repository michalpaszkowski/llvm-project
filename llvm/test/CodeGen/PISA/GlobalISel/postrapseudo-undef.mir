# RUN: llc -march=pisa -run-pass=postrapseudos -verify-machineinstrs %s -o -   | FileCheck -check-prefix=PSEUDO %s
# RUN: llc -march=pisa -start-before=postrapseudos -verify-machineinstrs %s -o - | FileCheck -check-prefix=ASM  %s
--- |
  define i32 @test_copy_undef(i32 %arg) {
    ret i32 %arg
  }
...
---
name:            test_copy_undef
legalized:       true
regBankSelected: true
tracksRegLiveness: true
body:             |
  bb.1:
    ; PSEUDO-LABEL: {{^}}name: test_copy_undef
    ; ASM-LABEL: @test_copy_undef
    ; PSEUDO: undef %v4.sub32_0:regv4_32b = mov_i32_r %0
    ; PSEUDO: %v4.sub32_1:regv4_32b = mov_i32_r %0
    ; PSEUDO: %v4.sub32_2:regv4_32b = mov_i32_r %0
    ; PSEUDO: %v4.sub32_3:regv4_32b = mov_i32_r %0
    ; ASM: mov.32b [[REG:%v4w[0-9]+]].x, %w0
    ; ASM: mov.32b [[REG]].y, %w0
    ; ASM: mov.32b [[REG]].z, %w0
    ; ASM: mov.32b [[REG]].w, %w0
    %0:reg32b(i32) = functionParameter_i32 0
    undef %v4.sub32_0:regv4_32b = COPY %0:reg32b
    %v4.sub32_1:regv4_32b = COPY %0:reg32b
    %v4.sub32_2:regv4_32b = COPY %0:reg32b
    %v4.sub32_3:regv4_32b = COPY %0:reg32b
    retValue_i32_r %0:reg32b(i32)

...
