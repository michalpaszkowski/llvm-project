# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 5
# RUN: llc -O0 -march=pisa -run-pass=pisa-legalize-predicates -verify-machineinstrs %s -o - | FileCheck %s

# At -O0 the pass early-returns (CodeGenOptLevel::None), so a chain that would
# otherwise be promoted is left untouched (input == output). This guards the
# opt-level check in runOnMachineFunction.

--- |
  source_filename = "<stdin>"
  target datalayout = "e-p:64:64-p1:64:64-p2:64:64-p3:32:32-p4:32:32-i1:8:8-i8:8:8-i16:16:16-i32:32:32-i64:64:64-f32:32:32-f64:64:64-v16:16:16-v24:32:32-v32:32:32-v48:64:64-v64:64:64-v96:128:128-v128:128:128-v192:256:256-v256:256:256-G1-A4"
  target triple = "pisa"

  define i32 @optnone_no_promote(i32 %a, i32 %b, i32 %c, ptr addrspace(1) %p) {
    %c1 = icmp slt i32 %a, 0
    %c2 = icmp slt i32 %b, 0
    %c3 = icmp slt i32 %c, 0
    %a1 = and i1 %c1, %c2
    %a2 = and i1 %c2, %c3
    %e = icmp eq i1 %a1, %a2
    %z = zext i1 %e to i32
    store i32 %z, ptr addrspace(1) %p
    ret i32 %z
  }
...
---
name:            optnone_no_promote
tracksRegLiveness: true
isSSA:           true
body:             |
  bb.1 (%ir-block.0):
    ; CHECK-LABEL: name: optnone_no_promote
    ; CHECK: %0:reg32b(i32) = functionParameter_i32 0
    ; CHECK-NEXT: %1:reg32b(i32) = functionParameter_i32 1
    ; CHECK-NEXT: %2:reg32b(i32) = functionParameter_i32 2
    ; CHECK-NEXT: %3:reg64b(p1) = functionParameter_i64 3
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 0
    ; CHECK-NEXT: [[ICMP:%[0-9]+]]:_(i1) = G_ICMP intpred(slt), %0(i32), [[C]]
    ; CHECK-NEXT: [[ICMP1:%[0-9]+]]:_(i1) = G_ICMP intpred(slt), %1(i32), [[C]]
    ; CHECK-NEXT: [[ICMP2:%[0-9]+]]:_(i1) = G_ICMP intpred(slt), %2(i32), [[C]]
    ; CHECK-NEXT: [[AND:%[0-9]+]]:_(i1) = G_AND [[ICMP]], [[ICMP1]]
    ; CHECK-NEXT: [[AND1:%[0-9]+]]:_(i1) = G_AND [[ICMP1]], [[ICMP2]]
    ; CHECK-NEXT: [[ICMP3:%[0-9]+]]:_(i1) = G_ICMP intpred(eq), [[AND]](i1), [[AND1]]
    ; CHECK-NEXT: [[ZEXT:%[0-9]+]]:_(i32) = G_ZEXT [[ICMP3]](i1)
    ; CHECK-NEXT: G_STORE [[ZEXT]](i32), %3(p1) :: (store (i32) into %ir.p, addrspace 1)
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:reg32b(i32) = COPY [[ZEXT]](i32)
    ; CHECK-NEXT: retValue_i32_r [[COPY]](i32)
    %0:reg32b(i32) = functionParameter_i32 0
    %1:reg32b(i32) = functionParameter_i32 1
    %2:reg32b(i32) = functionParameter_i32 2
    %3:reg64b(p1) = functionParameter_i64 3
    %4:_(i32) = G_CONSTANT i32 0
    %5:_(i1) = G_ICMP intpred(slt), %0(i32), %4
    %6:_(i1) = G_ICMP intpred(slt), %1(i32), %4
    %7:_(i1) = G_ICMP intpred(slt), %2(i32), %4
    %8:_(i1) = G_AND %5, %6
    %9:_(i1) = G_AND %6, %7
    %10:_(i1) = G_ICMP intpred(eq), %8(i1), %9
    %11:_(i32) = G_ZEXT %10(i1)
    G_STORE %11(i32), %3(p1) :: (store (i32) into %ir.p, addrspace 1)
    %12:reg32b(i32) = COPY %11(i32)
    retValue_i32_r %12(i32)
...
