    ; ASM-LABEL: @test_anyext_i8_i16
    %0:reg8b(i8) = functionParameter_i8 0
    ; ISEL: %{{[0-9]+}}:reg16b = zext_16b_8b_r %{{[0-9]+}}
    ; ASM:  zext.16b.8b %h{{[0-9]+}}, %b{{[0-9]+}}
