tracksRegLiveness: true
body:             |
  bb.1:
    ; ISEL-LABEL: {{^}}name: test_anyext_i8_i32
    ; ASM-LABEL: @test_anyext_i8_i32
    %0:reg8b(i8) = functionParameter_i8 0
    ; ISEL: %{{[0-9]+}}:reg32b = zext_32b_8b_r %{{[0-9]+}}
    ; ASM:  zext.32b.8b %w{{[0-9]+}}, %b{{[0-9]+}}
    %1:reg32b(i32) = G_ANYEXT %0(i8)
