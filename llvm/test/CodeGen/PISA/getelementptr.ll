; NOTE: Assertions have been autogenerated by utils/update_pisa_test_checks.py UTC_ARGS: --version 6
; RUN: llc < %s -march=pisa -verify-machineinstrs | FileCheck %s
; RUN: llc < %s -march=pisa -O0 -verify-machineinstrs | FileCheck --check-prefix=O0 %s

define i32 @test_gep(ptr addrspace(1) %p) {
; CHECK-LABEL: .32b @test_gep(
; CHECK-SAME: .reg .64b [[R64_D0:%[-a-zA-Z$._0-9]+]]
; CHECK: 	.reg .32b [[R32_W0:%[-a-zA-Z$._0-9]+]];
; CHECK: 	ld.global.32b	 [[R32_W0]], [[[R64_D0]] + 20];
; CHECK-NEXT: 	return [[R32_W0]];
;
; O0-LABEL: .32b @test_gep(
; O0-SAME: .reg .64b [[R64_D0:%[-a-zA-Z$._0-9]+]]
; O0: 	.reg .32b [[R32_W0:%[-a-zA-Z$._0-9]+]];
; O0: 	ld.global.32b	 [[R32_W0]], [[[R64_D0]] + 20];
; O0-NEXT: 	return [[R32_W0]];
  %inc = getelementptr i32, ptr addrspace(1) %p, i32 5
  %result = load i32, ptr addrspace(1) %inc
  ret i32 %result
}

define i32 @test_gep_dynamic(ptr addrspace(1) %p, i32 %idx) {
; CHECK-LABEL: .32b @test_gep_dynamic(
; CHECK-SAME: .reg .64b [[R64_D0:%[-a-zA-Z$._0-9]+]]
; CHECK-SAME: .reg .32b [[R32_W0:%[-a-zA-Z$._0-9]+]]
; CHECK: 	.reg .64b [[R64_D1:%[-a-zA-Z$._0-9]+]], [[R64_D2:%[-a-zA-Z$._0-9]+]];
; CHECK-NEXT: 	.reg .32b [[R32_W1:%[-a-zA-Z$._0-9]+]];
; CHECK: 	sext.64b.32b 	[[R64_D1]], [[R32_W0]];
; CHECK-NEXT: 	shl.64b 	[[R64_D2]], [[R64_D1]], 2;
; CHECK-NEXT: 	ld.global.32b	 [[R32_W1]], [[[R64_D0]] + [[R64_D2]]];
; CHECK-NEXT: 	return [[R32_W1]];
;
; O0-LABEL: .32b @test_gep_dynamic(
; O0-SAME: .reg .64b [[R64_D0:%[-a-zA-Z$._0-9]+]]
; O0-SAME: .reg .32b [[R32_W0:%[-a-zA-Z$._0-9]+]]
; O0: 	.reg .64b [[R64_D1:%[-a-zA-Z$._0-9]+]];
; O0-NEXT: 	.reg .32b [[R32_W1:%[-a-zA-Z$._0-9]+]];
; O0: 	smul.full.32b 	[[R64_D1]], [[R32_W0]], 4;
; O0-NEXT: 	ld.global.32b	 [[R32_W1]], [[[R64_D0]] + [[R64_D1]]];
; O0-NEXT: 	return [[R32_W1]];
  %inc = getelementptr [10 x i32], ptr addrspace(1) %p, i32 0, i32 %idx
  %result = load i32, ptr addrspace(1) %inc
  ret i32 %result
}
