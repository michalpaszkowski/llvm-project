; Test 4: Loop with an atomic read (or 0) dominating an atomic write (xchg)
; on the same shared pointer -- exercises moveAtomicWrites2Loop, getMemoryOperand,
; tryMovingWrite, and layoutBlocks with LoopInfo.
define void @test_move_atomic_write_to_loop(ptr addrspace(3) %ptr, i32 %limit) {
