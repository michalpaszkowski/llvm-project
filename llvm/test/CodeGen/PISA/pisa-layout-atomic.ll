; O0: 	iadd.32b 	%w8, %w5, 1;
; O0-NEXT: 	mov.32b 	%w4, %w8;
; O0-NEXT: 	goto [[LBB3_2]];
; O0-NEXT: [[LBB3_5]]:
; O0-NEXT: 	return;
;
; CHECK-LABEL: void @test_move_atomic_write_to_loop(
; CHECK-SAME: .reg .32b [[R32_W0:%[-a-zA-Z$._0-9]+]]
; CHECK-SAME: .reg .32b [[R32_W1:%[-a-zA-Z$._0-9]+]]
; CHECK: 	.reg .32b [[R32_W2:%[-a-zA-Z$._0-9]+]], [[R32_W3:%[-a-zA-Z$._0-9]+]], [[R32_W4:%[-a-zA-Z$._0-9]+]], [[R32_W5:%[-a-zA-Z$._0-9]+]], [[R32_W6:%[-a-zA-Z$._0-9]+]];
; CHECK-NEXT: 	.pred [[P_P0:%[-a-zA-Z$._0-9]+]];
; CHECK: 	mov.32b 	[[R32_W2]], 0;
; CHECK-NEXT: 	mov.32b 	[[R32_W3]], 1;
; CHECK-NEXT: 	mov.32b 	[[R32_W4]], [[R32_W2]];
; CHECK-NEXT: [[LBB3_1:LBB[0-9_]+]]:
; CHECK: 	iatom.shared.acquire.system.or.32b	 [[R32_W5]], [[[R32_W0]]], [[R32_W2]];
; CHECK-NEXT: 	scmp.lt.32b 	[[P_P0]], [[R32_W4]], [[R32_W1]];
; CHECK-NEXT: 	goto.cond ![[P_P0]], [[LBB3_3:LBB[0-9_]+]];
; CHECK: 	iatom.shared.release.system.xchg.32b	 [[R32_W6]], [[[R32_W0]]], [[R32_W3]];
; CHECK-NEXT: 	iadd.32b 	[[R32_W4]], [[R32_W4]], 1;
