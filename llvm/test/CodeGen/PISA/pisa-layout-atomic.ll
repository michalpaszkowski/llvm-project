entry:
  br label %loop.header

loop.header:
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop.latch ]
  %rval = atomicrmw or ptr addrspace(3) %ptr, i32 0 acquire
  %cond = icmp slt i32 %i, %limit
  br i1 %cond, label %loop.body, label %loop.exit

loop.body:
  %old = atomicrmw xchg ptr addrspace(3) %ptr, i32 1 release
  br label %loop.latch

loop.latch:
  %i.next = add i32 %i, 1
  br label %loop.header

loop.exit:
  ret void
}

