; NOTE: Assertions have been autogenerated by utils/update_pisa_test_checks.py UTC_ARGS: --version 6
; Test that we can return immediate values.
; For now the immeidates are not folded so that we can test the various constant_* MIR opcodes.
; TODO: add vector immediate support

; RUN: llc < %s -march=pisa | FileCheck %s
; RUN: llc < %s -march=pisa -O0 -verify-machineinstrs

define i16 @test_imm16ret() {
; CHECK-LABEL: .16b @test_imm16ret(
; CHECK: 	.reg .16b [[R16_H0:%[-a-zA-Z$._0-9]+]];
; CHECK: 	mov.16b 	[[R16_H0]], 125;
; CHECK-NEXT: 	return [[R16_H0]];
  ret i16 125
}

define i32 @test_imm32ret() {
; CHECK-LABEL: .32b @test_imm32ret(
; CHECK: 	.reg .32b [[R32_W0:%[-a-zA-Z$._0-9]+]];
; CHECK: 	mov.32b 	[[R32_W0]], 100;
; CHECK-NEXT: 	return [[R32_W0]];
  ret i32 100
}

define i64 @test_imm64ret() {
; CHECK-LABEL: .64b @test_imm64ret(
; CHECK: 	.reg .64b [[R64_D0:%[-a-zA-Z$._0-9]+]];
; CHECK: 	mov.64b 	[[R64_D0]], 42;
; CHECK-NEXT: 	return [[R64_D0]];
  ret i64 42
}

; TODO: Should we emit non-hex floating point literals so they are easier to read?
define half @test_fpimm16ret() {
  ret  half 0xH3C00
}

define float @test_fpimm32ret() {
  ret float 5.000000e-01
}

define double @test_fpimm64ret() {
  ret double 2.000000e03
}

