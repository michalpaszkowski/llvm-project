; Test checks that no dbz is produced in PISA TTI when handling vectors of ptr

target datalayout = "e-p:32:32-p1:64:64-p2:64:64-p3:32:32-p4:64:64-i1:8:8-i8:8:8-i16:16:16-i32:32:32-i64:64:64-f32:32:32-f64:64:64-v16:16:16-v24:32:32-v32:32:32-v48:64:64-v64:64:64-v96:128:128-v128:128:128-v192:256:256-v256:256:256-G1"
target triple = "pisa"

define pisa_kernel void @shuffle_ptr(ptr %GV) {
; CHECK-LABEL: define pisa_kernel void @shuffle_ptr(
; CHECK-SAME: ptr [[GV:%.*]]) {
; CHECK-NEXT:    [[LGV:%.*]] = load <16 x ptr>, ptr [[GV]], align 128
; CHECK-NEXT:    [[S:%.*]] = shufflevector <16 x ptr> [[LGV]], <16 x ptr> splat (ptr null), <1 x i32> zeroinitializer
; CHECK-NEXT:    [[E:%.*]] = extractelement <1 x ptr> [[S]], i32 0
; CHECK-NEXT:    store ptr [[E]], ptr addrspace(1) null, align 8
; CHECK-NEXT:    ret void
;
  %LGV = load <16 x ptr>, ptr %GV, align 128
  %S = shufflevector <16 x ptr> %LGV, <16 x ptr> splat (ptr null), <1 x i32> zeroinitializer
  %e = extractelement <1 x ptr> %S, i32 0
  store ptr %e, ptr addrspace(1) null, align 8
  ret void
}
