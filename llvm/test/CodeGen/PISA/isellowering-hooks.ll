; isReassocProfitable: PISA overrides reassociation to preserve MAD selection.
; Pattern: ((a*b) + C) + (c*d) triggers tryReassocBinOp -> isReassocProfitable.
; The PISA override detects mul+add pattern and returns false to preserve MAD,
; resulting in two smad instructions using the fused-multiply-add selection.
define i32 @reassoc_preserves_mad(i32 %a, i32 %b, i32 %c, i32 %d) {
; O0-LABEL: .32b @reassoc_preserves_mad(
; O0-SAME: .reg .32b [[R32_W0:%[-a-zA-Z$._0-9]+]]
; O0-SAME: .reg .32b [[R32_W1:%[-a-zA-Z$._0-9]+]]
; O0-SAME: .reg .32b [[R32_W2:%[-a-zA-Z$._0-9]+]]
; O0-SAME: .reg .32b [[R32_W3:%[-a-zA-Z$._0-9]+]]
; O0: 	.reg .32b [[R32_W4:%[-a-zA-Z$._0-9]+]], [[R32_W5:%[-a-zA-Z$._0-9]+]];
; O0: 	smad.32b 	[[R32_W4]], [[R32_W0]], [[R32_W1]], 42;
; O0-NEXT: 	smad.32b 	[[R32_W5]], [[R32_W2]], [[R32_W3]], [[R32_W4]];
; O0-NEXT: 	return [[R32_W5]];
;
; CHECK-LABEL: .32b @reassoc_preserves_mad(
; CHECK-SAME: .reg .32b [[R32_W0:%[-a-zA-Z$._0-9]+]]
; CHECK-SAME: .reg .32b [[R32_W1:%[-a-zA-Z$._0-9]+]]
; CHECK-SAME: .reg .32b [[R32_W2:%[-a-zA-Z$._0-9]+]]
; CHECK-SAME: .reg .32b [[R32_W3:%[-a-zA-Z$._0-9]+]]
; CHECK: 	.reg .32b [[R32_W4:%[-a-zA-Z$._0-9]+]], [[R32_W5:%[-a-zA-Z$._0-9]+]];
; CHECK: 	smad.32b 	[[R32_W4]], [[R32_W0]], [[R32_W1]], 42;
; CHECK-NEXT: 	smad.32b 	[[R32_W5]], [[R32_W2]], [[R32_W3]], [[R32_W4]];
; CHECK-NEXT: 	return [[R32_W5]];
  %mul1   = mul i32 %a, %b
  %inner  = add i32 %mul1, 42
  %mul2   = mul i32 %c, %d
  %result = add i32 %inner, %mul2
  ret i32 %result
}

